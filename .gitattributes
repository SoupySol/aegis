# Auto-detect text files and perform LF normalization
* text=auto

# Enforce LF for web, scripts, configs, and documentation
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.css text eol=lf
*.ps1 text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Enforce CRLF for Windows batch and C# / Visual Studio files
*.bat text eol=crlf
*.cmd text eol=crlf
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.dll binary
