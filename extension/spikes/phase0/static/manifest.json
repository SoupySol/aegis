{
  "manifest_version": 3,
  "name": "Aegis Phase 0 Spike (dev only)",
  "version": "0.0.1",
  "description": "DEV SPIKE: tests clipboard guard, paste guard and wallet request interception. Local only, no network.",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "clipboardRead", "clipboardWrite", "notifications"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "128": "icon128.png" },
  "action": { "default_title": "Aegis spike", "default_icon": { "128": "icon128.png" } },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}

